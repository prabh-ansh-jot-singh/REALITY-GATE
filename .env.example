# REALITY-GATE v2.0 — Environment Configuration
# Copy to `.env` to override local defaults.

# Server & Persistence
REALITY_GATE_HOST=127.0.0.1
REALITY_GATE_PORT=8000
REALITY_GATE_DB_PATH=./reality_gate.db
REALITY_GATE_AUDIT_PATH=./logs/audit.jsonl

# Cryptographic HMAC-SHA256 Secrets (rotate in production)
REALITY_GATE_JIT_SECRET=change-me-to-a-256-bit-random-secret
REALITY_GATE_TELEMETRY_SECRET=change-me-to-a-telemetry-hmac-secret

# Deterministic Invariant Thresholds
RG_NOISE_FLOOR_PKT_HR=10
RG_FRESHNESS_SLA_SEC=300
RG_JIT_TTL_SEC=60

# Optional Live Enterprise Integrations (leave blank to use local SQLite adapters)
AZURE_SUBSCRIPTION_ID=sub-apex-retail-prod-441
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
SERVICENOW_INSTANCE_URL=https://apexretail.service-now.com
TEAMS_WEBHOOK_URL=
